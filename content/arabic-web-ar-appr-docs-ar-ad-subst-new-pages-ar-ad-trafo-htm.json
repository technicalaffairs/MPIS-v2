 "sections": [
  {
   "type": "heading",
   "level": 1,
   "text": "الشركة القابضة لكهرباء مصر"
  },
  {
   "type": "heading",
   "level": 2,
   "text": "نظام معلومات إجراءات الصيانة (MPIS)"
  },
  {
   "type": "paragraph",
   "text": "14سبتمبر 2002"
  },
  {
   "type": "paragraph",
   "text": "اختبار نظام \n الإطفاء \n التلقائى بالمياه للمحول 11/220/500ك ف باستخدام مضخة قدرة 150حصان \n باسوس"
  },
  {
   "type": "paragraph",
   "text": "12 يونيو 1996"
  },
  {
   "type": "paragraph",
   "text": "طريقة أخذ عينة الزيت من \n المحولات للتحليل الأساسى"
  },
  {
   "type": "paragraph",
   "text": "17 أكتوبر 2001"
  },
  {
   "type": "paragraph",
   "text": "الصيانة من شهر الى 3 اشهر\nلمحولات القدرة 25 م ف أ \n جهد \n11/66 ك ف"
  },
  {
   "type": "paragraph",
   "text": "المستند 06 سبتمبر 1999"
  },
  {
   "type": "paragraph",
   "text": "محولات القدرة 125 م ف أ ترافو يونيون - قائمة الفحص السنوى I1-Y1"
  },
  {
   "type": "paragraph",
   "text": "06 سبتمبر 1999"
  },
  {
   "type": "paragraph",
   "text": "الصيانة\nالسنوية لمحول القدرة\nTU\n 125 م ف أ"
  },
  {
   "type": "paragraph",
   "text": "06 سبتمبر 1999"
  },
  {
   "type": "paragraph",
   "text": "الفحص الشهري لمحول القدرة \nFuji \n 125 م ف أ"
  },
  {
   "type": "paragraph",
   "text": "المستند 06 سبتمبر 1999"
  },
  {
   "type": "paragraph",
   "text": "محولات القدرة 125 م ف أ فوجى - الفحص السنوى (I1-Y1)"
  },
  {
   "type": "paragraph",
   "text": "06 سبتمبر 1999"
  },
  {
   "type": "paragraph",
   "text": "الصيانة\nالسنوية لمحول القدرة \nFuji \n 125 م ف أ"
  },
  {
   "type": "paragraph",
   "text": "مستند فني رقم T-022-r0a"
  },
  {
   "type": "paragraph",
   "text": "05 فبراير 2001"
  },
  {
   "type": "paragraph",
   "text": "محول القدرة اختبار مقاومة الملفات بالتيار المستمر - إجراء (إجراءات) الاختبار"
  },
  {
   "type": "paragraph",
   "text": "مستند فني رقم T-024-r0a"
  },
  {
   "type": "paragraph",
   "text": "05 فبراير 2001"
  },
  {
   "type": "paragraph",
   "text": "اختبار محولات القدرة ثلاثية الملفات اختبار الميجر بجهد 5000 فولت - إجراء (إجراءات) الاختبار"
  },
  {
   "type": "paragraph",
   "text": "مستند فني رقم T-025-r0a"
  },
  {
   "type": "paragraph",
   "text": "05 فبراير 2001"
  },
  {
   "type": "paragraph",
   "text": "قياس سعة العزل وعامل الفقد (تان دلتا) لمحولات ثنائية الملفات طراز CB 100 TEOF - إجراء (إجراءات) الاختبار"
  },
  {
   "type": "paragraph",
   "text": "مستند فني رقم T-026-r0a"
  },
  {
   "type": "paragraph",
   "text": "05 فبراير 2001"
  },
  {
   "type": "paragraph",
   "text": "محولات ثنائية الملفات اختبار الميجر (5000 فولت) - إجراءات الاختبار"
  },
  {
   "type": "paragraph",
   "text": "مستند فني رقم T-027-r0a"
  },
  {
   "type": "paragraph",
   "text": "05 فبراير 2001"
  },
  {
   "type": "paragraph",
   "text": "محولات القدرة - اختبار نسبة التحويل"
  },
  {
   "type": "paragraph",
   "text": "03 \n مارس 2002"
  },
  {
   "type": "paragraph",
   "text": "09 \n مارس 2002"
  },
  {
   "type": "paragraph",
   "text": "الفحص \n الاسبوعى لمحولات القدرة66/11 ك ف ، 25 م ف أ، البروم\nبلغاريا شيراتون المطار 66"
  },
  {
   "type": "paragraph",
   "text": "الصيانة \n كل ثلاث شهور لمحولات القدرة66/11 ك ف ، 25 م ف أ، البروم\nبلغاريا \n شيراتون المطار 66"
  },
  {
   "type": "paragraph",
   "text": "الصيانة \n السنوية لمحولات القدرة66/11 ك ف ، 25 م ف أ، البروم\nبلغاريا \n شيراتون المطار 66"
  },
  {
   "type": "paragraph",
   "text": "الفحص \n الاسبوعي لمحولات القدرة66/11 ك ف ، 25 م ف أ، ايه بي بي \n تركيا \nالتجمع الاول 66"
  },
  {
   "type": "paragraph",
   "text": "الصيانة كل ثلاثة شهور \n لمحولات القدرة66/11 ك ف ، 25 م ف أ، ايه بي بي تركيا \nالتجمع \n الأول \n 66"
  },
