 "sections_ar": [
  {
   "type": "heading",
   "level": 1,
   "text": "الشركة القابضة لكهرباء مصر"
  },
  {
   "type": "heading",
   "level": 2,
   "text": "قطاع MPIS ومراقبة الجودة"
  },
  {
   "type": "heading",
   "level": 3,
   "text": "الإنتاج"
  },
  {
   "type": "paragraph",
   "text": "الوصول إلى مستندات شركات التوليد، وإرشادات صيانة الغلايات والتوربينات."
  },
  {
   "type": "heading",
   "level": 3,
   "text": "الشركة المصرية لنقل الكهرباء (EETC) – النقل"
  },
  {
   "type": "paragraph",
   "text": "معايير محطات الشركة المصرية لنقل الكهرباء، ومواصفات الشبكة، وخطوط النقل."
  },
  {
   "type": "heading",
   "level": 3,
   "text": "التوزيع"
  },
  {
   "type": "paragraph",
   "text": "بروتوكولات شركات التوزيع، ومعايير موازنة الأحمال، والمؤشرات الإقليمية."
  },
  {
   "type": "heading",
   "level": 3,
   "text": "المحطات الفرعية والمعدات"
  },
  {
   "type": "heading",
   "level": 3,
   "text": "أنظمة توليد القوى"
  },
  {
   "type": "heading",
   "level": 3,
   "text": "النقل والتحكم والحماية"
  },
  {
   "type": "heading",
   "level": 3,
   "text": "الإدارة والمعايير والتوجيهات"
  },
  {
   "type": "paragraph",
   "text": "حقوق الطبع محفوظة © الشركة القابضة لكهرباء مصر، قطاع MPIS ومراقبة الجودة، 2026. جميع الحقوق محفوظة."
  },
  {
   "type": "paragraph",
   "text": "مُحسَّن لمتصفحات الويب الحديثة المتجاوبة."
  },
  {
   "type": "paragraph",
   "text": "تم التطوير بواسطة: إدارة الشئون الفنية، منطقة كهرباء مصر الوسطى، القطاع الجنوبي."
  }
 ],
 "text_ar": "الشركة القابضة لكهرباء مصر\nقطاع MPIS ومراقبة الجودة\nالإنتاج\nالوصول إلى مستندات شركات التوليد، وإرشادات صيانة الغلايات والتوربينات.\nالشركة المصرية لنقل الكهرباء (EETC) – النقل\nمعايير محطات الشركة المصرية لنقل الكهرباء، ومواصفات الشبكة، وخطوط النقل.\nالتوزيع\nبروتوكولات شركات التوزيع، ومعايير موازنة الأحمال، والمؤشرات الإقليمية.\nالمحطات الفرعية والمعدات\nأنظمة توليد القوى\nالنقل والتحكم والحماية\nالإدارة والمعايير والتوجيهات\nحقوق الطبع محفوظة © الشركة القابضة لكهرباء مصر، قطاع MPIS ومراقبة الجودة، 2026. جميع الحقوق محفوظة.\nمُحسَّن لمتصفحات الويب الحديثة المتجاوبة.\nتم التطوير بواسطة: إدارة الشئون الفنية، منطقة كهرباء مصر الوسطى، القطاع الجنوبي.",
 "translation_review": "draft — needs human review before operational use"
}